# AURA PM Engine — provider credentials
# Copy to `.env` (same folder, git-ignored) or run `pm-engine setup arena --key … --check`,
# which writes ~/.aura/pm-engine.env instead. Real environment variables always win over these files.

# ── Arena.ai (preferred when set) ───────────────────────────────────────────
ARENA_API_KEY=
# API root of the Arena model endpoint. Default: https://api.arena.ai/v1
#ARENA_BASE_URL=https://api.arena.ai/v1
# Model id to request. Default: claude-sonnet-4-5  (list what your key can use: `pm-engine providers --check`)
#ARENA_MODEL=claude-sonnet-4-5
# Wire format: auto (default: try OpenAI chat/completions, fall back to Anthropic messages) | openai | anthropic
#ARENA_API_FORMAT=auto
# Auth header: bearer (default → Authorization: Bearer <key>) | x-api-key | <custom header name>
#ARENA_AUTH_HEADER=bearer

# ── Other backends ──────────────────────────────────────────────────────────
#ANTHROPIC_API_KEY=
#OPENAI_API_KEY=
#OPENAI_BASE_URL=https://api.openai.com/v1
#OLLAMA_HOST=http://127.0.0.1:11434

# Force a backend regardless of which keys are present: arena | anthropic | openai | ollama | offline
#PM_ENGINE_PROVIDER=arena
#PM_ENGINE_MAX_RETRIES=3
