# AURA PM Engine — provider credentials
# Copy to `.env` (same folder, git-ignored) or run `pm-engine setup <provider> --key … --check`,
# which writes ~/.aura/pm-engine.env instead. Real environment variables always win over these files.
# Quickest free option: GitHub Models — `pm-engine setup github --key <fine-grained PAT with Models: read>`

# ── OpenAI-compatible gateways (GitHub Models, OpenRouter, Groq, Gemini, OpenAI, vLLM, LM Studio…) ──
#OPENAI_API_KEY=
#OPENAI_BASE_URL=https://models.github.ai/inference        # GitHub Models (free)      → model e.g. openai/gpt-4o-mini
#OPENAI_BASE_URL=https://openrouter.ai/api/v1              # OpenRouter (":free" ids)  → model e.g. openai/gpt-oss-120b:free
#OPENAI_BASE_URL=https://api.groq.com/openai/v1            # Groq (free tier)          → model e.g. llama-3.3-70b-versatile
#OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai   # Gemini → model e.g. gemini-2.5-flash
#PM_ENGINE_OPENAI_MODEL=openai/gpt-4o-mini

# ── Arena.ai ─────────────────────────────────────────────────────────────────
# Only if you have Arena API access: arena.ai publishes no public model API, so BOTH values are required.
#ARENA_API_KEY=
#ARENA_BASE_URL=https://<host-from-your-arena-api-docs>/v1
#ARENA_MODEL=claude-sonnet-4-5
#ARENA_API_FORMAT=auto        # auto (OpenAI chat/completions, fall back to Anthropic messages) | openai | anthropic
#ARENA_AUTH_HEADER=bearer     # bearer | x-api-key | <custom header name>

# ── Other backends ──────────────────────────────────────────────────────────
#ANTHROPIC_API_KEY=
#OLLAMA_HOST=http://127.0.0.1:11434

# Force a backend regardless of which keys are present: arena | anthropic | openai | ollama | offline
#PM_ENGINE_PROVIDER=openai
#PM_ENGINE_MAX_RETRIES=3
